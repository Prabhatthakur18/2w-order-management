// Dealer Order Management System — Prisma schema
// See TECH_STACK.md for the reasoning behind these models.
//
// Money rule: every monetary column is Decimal(14,2). Never Float.
// Document rule: generated PDFs/PIs are not stored. Only their numbers are.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─────────────────────────────────────────────────────────────
// IDENTITY & ACCESS
// ─────────────────────────────────────────────────────────────

enum Role {
  ADMIN
  ASM
  PLANT_OPS
  ACCOUNTS
  DISPATCH
  DEALER // dormant in phase 1 — see TECH_STACK.md §2
}

model User {
  id           String    @id @default(cuid())
  email        String    @unique
  name         String
  passwordHash String
  phone        String?
  isActive     Boolean   @default(true)
  lastLoginAt  DateTime?

  roles UserRole[]

  // A DEALER-role user is linked to the dealer they represent.
  dealerId String?
  dealer   Dealer? @relation("DealerPortalUser", fields: [dealerId], references: [id])

  createdOrders  Order[]           @relation("OrderCreatedBy")
  auditLogs      AuditLog[]
  notifications  Notification[]
  documentIssues DocumentIssueLog[]
  uploadedFiles  FileAsset[]

  dealersCreated     Dealer[]    @relation("DealerCreatedBy")
  dealersReviewed    Dealer[]    @relation("DealerReviewedBy")
  subDealersCreated  SubDealer[] @relation("SubDealerCreatedBy")
  subDealersReviewed SubDealer[] @relation("SubDealerReviewedBy")
  loginOtps          LoginOtp[]

  ekycProfilesCreated  EkycProfile[] @relation("EkycProfileCreatedBy")
  ekycProfilesReviewed EkycProfile[] @relation("EkycProfileReviewedBy")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([email])
  @@index([dealerId])
}

model UserRole {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  role   Role

  @@unique([userId, role])
  @@index([userId])
}

// ─────────────────────────────────────────────────────────────
// ADMIN-CONTROLLED MASTERS
// ─────────────────────────────────────────────────────────────

// Any dealer/sub-dealer added by an ASM starts PENDING and is invisible to
// order creation until an Admin approves it. Admin-seeded masters are
// created directly as APPROVED.
enum MasterApprovalStatus {
  PENDING
  APPROVED
  REJECTED
}

model Dealer {
  id          String  @id @default(cuid())
  code        String  @unique
  name        String
  gstin       String?
  address     String
  city        String
  state       String
  pincode     String
  contactName String?
  contactNo   String
  email       String?
  isActive    Boolean @default(true)

  // GST-lookup fields, kept as returned by the provider for reference —
  // the ASM-editable fields above are the source of truth for the order.
  gstLegalName    String?
  gstTradeName    String?
  gstStatus       String?
  gstRegisteredAt DateTime?

  approvalStatus MasterApprovalStatus @default(APPROVED)
  createdById    String?
  createdBy      User?          @relation("DealerCreatedBy", fields: [createdById], references: [id])
  reviewedById   String?
  reviewedBy     User?          @relation("DealerReviewedBy", fields: [reviewedById], references: [id])
  reviewedAt     DateTime?
  rejectedReason String?

  // Credit terms — Admin controlled
  creditLimit    Decimal? @db.Decimal(14, 2)
  creditDays     Int?
  priceTierId    String?
  priceTier      DealerPriceTier? @relation(fields: [priceTierId], references: [id])

  subDealers          SubDealer[]
  printingFrames      PrintingFrame[]
  orders              Order[]
  users               User[] @relation("DealerPortalUser")
  dealerNotifications DealerNotification[]
  ekycProfile         EkycProfile?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([code])
  @@index([isActive])
  @@index([approvalStatus])
}

// Report Rec #1 — replaces free-text sub-dealer entry.
model SubDealer {
  id        String  @id @default(cuid())
  dealerId  String
  dealer    Dealer  @relation(fields: [dealerId], references: [id], onDelete: Cascade)
  name      String
  gstin     String?
  address   String
  city      String?
  state     String?
  pincode   String?
  contactNo String
  email     String?
  isActive  Boolean @default(true)

  // GST-lookup fields, kept as returned by the provider for reference —
  // the ASM-editable fields above are the source of truth for the order.
  gstLegalName    String?
  gstTradeName    String?
  gstStatus       String?
  gstRegisteredAt DateTime?

  approvalStatus MasterApprovalStatus @default(APPROVED)
  createdById    String?
  createdBy      User?          @relation("SubDealerCreatedBy", fields: [createdById], references: [id])
  reviewedById   String?
  reviewedBy     User?          @relation("SubDealerReviewedBy", fields: [reviewedById], references: [id])
  reviewedAt     DateTime?
  rejectedReason String?

  orders      Order[]
  ekycProfile EkycProfile?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([dealerId])
  @@index([name])
  @@index([approvalStatus])
}

// eKYC — independent of Dealer/SubDealer approvalStatus above (which
// already governs order-usability on its own). One profile per dealer OR
// per sub-dealer (never both), created lazily on first document upload.
// One file per EkycDocType; re-uploading replaces the existing file.
enum EkycDocType {
  AADHAR
  PAN
  CANCELLED_CHEQUE
  MOU
}

model EkycProfile {
  id String @id @default(cuid())

  dealerId    String?
  dealer      Dealer?    @relation(fields: [dealerId], references: [id], onDelete: Cascade)
  subDealerId String?
  subDealer   SubDealer? @relation(fields: [subDealerId], references: [id], onDelete: Cascade)

  approvalStatus MasterApprovalStatus @default(PENDING)
  createdById    String?
  createdBy      User?     @relation("EkycProfileCreatedBy", fields: [createdById], references: [id])
  reviewedById   String?
  reviewedBy     User?     @relation("EkycProfileReviewedBy", fields: [reviewedById], references: [id])
  reviewedAt     DateTime?
  rejectedReason String?

  // Manual note the ASM writes for the MoU slot.
  mouNote String?

  documents EkycDocument[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([dealerId])
  @@unique([subDealerId])
  @@index([approvalStatus])
}

model EkycDocument {
  id            String      @id @default(cuid())
  ekycProfileId String
  ekycProfile   EkycProfile @relation(fields: [ekycProfileId], references: [id], onDelete: Cascade)
  docType       EkycDocType

  fileAssetId String
  fileAsset   FileAsset @relation(fields: [fileAssetId], references: [id])

  uploadedById String?
  uploadedAt   DateTime @default(now())

  @@unique([ekycProfileId, docType])
}

enum PrintingFrameMode {
  IMAGE
  CONTENT
}

// Report Rec #2 — artwork (or text content) stored once per dealer, reused
// across orders. Two modes: an uploaded image, or typed content with a
// language and an OEM-logo toggle. Exactly one of fileAssetId/contentText
// is set, matching mode.
model PrintingFrame {
  id   String            @id @default(cuid())
  mode PrintingFrameMode @default(IMAGE)

  dealerId String
  dealer   Dealer @relation(fields: [dealerId], references: [id], onDelete: Cascade)
  label    String

  // IMAGE mode
  fileAssetId String?
  fileAsset   FileAsset? @relation(fields: [fileAssetId], references: [id])

  // CONTENT mode — language is a BCP-47 tag (e.g. "en", "hi"), resolved to a
  // display name client-side via Intl.DisplayNames — no language master needed.
  contentText     String?
  contentLanguage String?
  withOemLogo     Boolean?

  isDefault Boolean @default(false)
  isActive  Boolean @default(true)

  orders Order[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([dealerId])
}

model DealerPriceTier {
  id          String   @id @default(cuid())
  name        String   @unique
  description String?
  isActive    Boolean  @default(true)

  dealers Dealer[]
  prices  PriceList[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ── Catalog: OEM → Vehicle → Part → PartColour ──

model Oem {
  id       String  @id @default(cuid())
  code     String  @unique
  name     String
  isActive Boolean @default(true)

  vehicles Vehicle[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Vehicle {
  id       String  @id @default(cuid())
  oemId    String
  oem      Oem     @relation(fields: [oemId], references: [id], onDelete: Cascade)
  code     String
  name     String
  isActive Boolean @default(true)

  parts Part[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([oemId, code])
  @@index([oemId])
}

enum PackingUnit {
  PC
  SET
}

model Part {
  id          String      @id @default(cuid())
  vehicleId   String
  vehicle     Vehicle     @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
  partNo      String
  name        String
  hsnCode     String?
  packingUnit PackingUnit @default(PC)
  unitsPerSet Int?
  isActive    Boolean     @default(true)

  gstSlabId String?
  gstSlab   GstSlab? @relation(fields: [gstSlabId], references: [id])

  colours PartColour[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([vehicleId, partNo])
  @@index([vehicleId])
  @@index([partNo])
}

model PartColour {
  id       String  @id @default(cuid())
  partId   String
  part     Part    @relation(fields: [partId], references: [id], onDelete: Cascade)
  colour   String
  colourCode String?
  // Report: Product Code is system-generated from OEM/Vehicle/Part/Colour.
  productCode String @unique
  isActive Boolean @default(true)

  prices     PriceList[]
  orderLines OrderLine[]
  inventory  InventoryItem?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([partId, colour])
  @@index([partId])
  @@index([productCode])
}

// ── Pricing & tax (Admin controlled, date-effective) ──

model GstSlab {
  id         String   @id @default(cuid())
  name       String   @unique
  ratePct    Decimal  @db.Decimal(5, 2)
  hsnCode    String?
  validFrom  DateTime
  validTo    DateTime?
  isActive   Boolean  @default(true)

  parts Part[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([validFrom, validTo])
}

// Date-effective price. An order snapshots the price in effect at order time;
// later revisions never alter a placed order.
model PriceList {
  id           String   @id @default(cuid())
  partColourId String
  partColour   PartColour @relation(fields: [partColourId], references: [id], onDelete: Cascade)
  priceTierId  String?
  priceTier    DealerPriceTier? @relation(fields: [priceTierId], references: [id])
  unitPrice    Decimal  @db.Decimal(14, 2)
  validFrom    DateTime
  validTo      DateTime?
  isActive     Boolean  @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([partColourId, validFrom])
  @@index([priceTierId])
}

// Report Rec #4 — caps and stacking rules, Admin controlled.
// Dealer discount must sit within [minDealerPct, maxDealerPct]. The order is
// never rejected for being outside the band — it is flagged so an Admin
// must approve it (Order.needsDiscountApproval), per business direction.
model DiscountRule {
  id           String  @id @default(cuid())
  name         String
  minDealerPct Decimal @db.Decimal(5, 2)
  maxDealerPct Decimal @db.Decimal(5, 2)
  isActive     Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Scheme {
  id          String   @id @default(cuid())
  code        String   @unique
  name        String
  description String?
  discountPct Decimal? @db.Decimal(5, 2)
  flatAmount  Decimal? @db.Decimal(14, 2)
  validFrom   DateTime
  validTo     DateTime?
  isActive    Boolean  @default(true)

  orders Order[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([validFrom, validTo])
}

// Report Rec #10 — replaces free-text transporter entry.
model Transporter {
  id        String  @id @default(cuid())
  code      String  @unique
  name      String
  contactNo String?
  gstin     String?
  isActive  Boolean @default(true)

  dispatches      Dispatch[]
  preferredOrders Order[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// Every business toggle the report left open lives here. See TECH_STACK.md §8.
model SystemConfig {
  id        String   @id @default(cuid())
  key       String   @unique
  value     String
  valueType String   @default("string") // string | number | boolean | json
  category  String
  label     String
  description String?

  updatedById String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([category])
}

// ─────────────────────────────────────────────────────────────
// ORDERS
// ─────────────────────────────────────────────────────────────

enum OrderStatus {
  DRAFT // incomplete, still in the wizard
  CREATED // submitted; ASM may still edit until editableUntil
  PLACED // committed, either by the ASM or by the 24h auto-confirm
  PENDING_APPROVAL
  APPROVED
  DECLINED
  IN_PRODUCTION
  READY_FOR_DISPATCH
  INVOICED
  DISPATCHED
  CLOSED
  CANCELLED
}

enum PaymentMode {
  CREDIT
  ADVANCE
}

model Order {
  id          String      @id @default(cuid())
  orderNo     String      @unique
  status      OrderStatus @default(DRAFT)
  paymentMode PaymentMode?

  dealerId    String
  dealer      Dealer     @relation(fields: [dealerId], references: [id])
  subDealerId String?
  subDealer   SubDealer? @relation(fields: [subDealerId], references: [id])

  printingFrameId String?
  printingFrame   PrintingFrame? @relation(fields: [printingFrameId], references: [id])

  preferredTransporterId String?
  preferredTransporter   Transporter? @relation(fields: [preferredTransporterId], references: [id])

  // Module 1 — shipping
  shippingSameAsDealer Boolean @default(true)
  shippingAddress      String?
  shippingCity         String?
  shippingState        String?
  shippingPincode      String?

  // Module 2 — commercials. All Decimal(14,2).
  totalQty          Int      @default(0)
  grossValue        Decimal  @db.Decimal(14, 2) @default(0)
  dealerDiscountPct Decimal? @db.Decimal(5, 2)
  dealerDiscountAmt Decimal  @db.Decimal(14, 2) @default(0)
  // Dealer discount fell outside [DiscountRule.minDealerPct, maxDealerPct] —
  // order proceeds, but an Admin must approve it. Not a rejection.
  needsDiscountApproval Boolean @default(false)

  // Scheme is a selectable label only — no cost effect (business direction).
  schemeId          String?
  scheme            Scheme?  @relation(fields: [schemeId], references: [id])
  schemeDiscountAmt Decimal  @db.Decimal(14, 2) @default(0)

  netValue          Decimal  @db.Decimal(14, 2) @default(0) // before GST
  gstAmount         Decimal  @db.Decimal(14, 2) @default(0)
  totalValue        Decimal  @db.Decimal(14, 2) @default(0)
  // Advance payment only: 4% of the post-dealer-discount line value,
  // computed per line then summed (see OrderLine.cashDiscountAmt).
  cashDiscountAmt   Decimal  @db.Decimal(14, 2) @default(0)
  finalPayable      Decimal  @db.Decimal(14, 2) @default(0)

  // Credit payment only: ASM-entered term for this order, max 45 days,
  // termed "Credit Limit (days)" in the UI. Independent of Dealer.creditDays,
  // which is the dealer's general master default.
  creditDays Int?

  remarks String?

  // Proforma Invoice — number persisted, document generated at runtime.
  piNumber   String?   @unique
  piIssuedAt DateTime?

  createdById String
  createdBy   User   @relation("OrderCreatedBy", fields: [createdById], references: [id])

  lines               OrderLine[]
  versions            OrderVersion[]
  approvals           Approval[]
  payments            Payment[]
  production          ProductionRecord?
  invoices            Invoice[]
  dispatch            Dispatch?
  documentLog         DocumentIssueLog[]
  dealerNotifications DealerNotification[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Lifecycle: CREATED until editableUntil, then PLACED.
  // The ASM may place it early; otherwise the sweep confirms it on expiry.
  editableUntil DateTime?
  placedAt      DateTime?
  placedById    String?
  autoPlaced    Boolean   @default(false)

  @@index([status])
  @@index([status, editableUntil])
  @@index([dealerId])
  @@index([createdById])
  @@index([orderNo])
  @@index([createdAt])
}

// Price snapshot lives here — reproducible even if masters change later.
model OrderLine {
  id      String @id @default(cuid())
  orderId String
  order   Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)

  partColourId String
  partColour   PartColour @relation(fields: [partColourId], references: [id])

  productCode String
  description String
  packingUnit PackingUnit
  qty         Int

  unitPrice     Decimal @db.Decimal(14, 2)
  lineGross     Decimal @db.Decimal(14, 2)
  discountPct   Decimal @db.Decimal(5, 2) @default(0)
  discountAmt   Decimal @db.Decimal(14, 2) @default(0)
  // Advance payment only: 4% of (lineGross - discountAmt), i.e. the
  // post-dealer-discount value. Zero for Credit orders.
  cashDiscountAmt Decimal @db.Decimal(14, 2) @default(0)
  gstRatePct    Decimal @db.Decimal(5, 2) @default(0)
  gstAmount     Decimal @db.Decimal(14, 2) @default(0)
  lineNet       Decimal @db.Decimal(14, 2)

  // Per-item instruction for production/dispatch (e.g. packing or finish notes)
  remarks String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([orderId])
  @@index([partColourId])
}

// Report Rec #7 — decline/modify audit trail.
model OrderVersion {
  id            String   @id @default(cuid())
  orderId       String
  order         Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  versionNo     Int
  snapshot      Json
  changeReason  String?
  changedById   String?
  createdAt     DateTime @default(now())

  @@unique([orderId, versionNo])
  @@index([orderId])
}

enum ApprovalStatus {
  PENDING
  APPROVED
  DECLINED
  EXPIRED
}

// Report Rec #6 — the workflow's highest-risk gate, now with SLA tracking.
model Approval {
  id       String         @id @default(cuid())
  orderId  String
  order    Order          @relation(fields: [orderId], references: [id], onDelete: Cascade)
  status   ApprovalStatus @default(PENDING)

  requestedAt   DateTime  @default(now())
  respondedAt   DateTime?
  respondedById String?
  comments      String?

  // SLA — intervals come from SystemConfig.
  reminderDueAt   DateTime?
  escalationDueAt DateTime?
  reminderSentAt  DateTime?
  escalatedAt     DateTime?

  @@index([orderId])
  @@index([status])
  @@index([reminderDueAt])
}

enum PaymentStatus {
  PENDING
  PARTIAL
  RECEIVED
  VERIFIED
}

model Payment {
  id      String        @id @default(cuid())
  orderId String
  order   Order         @relation(fields: [orderId], references: [id], onDelete: Cascade)
  mode    PaymentMode
  status  PaymentStatus @default(PENDING)
  amount  Decimal       @db.Decimal(14, 2)

  referenceNo String?
  paidAt      DateTime?
  verifiedAt  DateTime?
  verifiedById String?

  receipts PaymentReceipt[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([orderId, mode])
  @@index([orderId])
}

model PaymentReceipt {
  id          String    @id @default(cuid())
  paymentId   String
  payment     Payment   @relation(fields: [paymentId], references: [id], onDelete: Cascade)
  fileAssetId String
  fileAsset   FileAsset @relation(fields: [fileAssetId], references: [id])
  uploadedAt  DateTime  @default(now())

  @@index([paymentId])
}

// ─────────────────────────────────────────────────────────────
// PRODUCTION & INVENTORY (Report Rec #9)
// ─────────────────────────────────────────────────────────────

model ProductionRecord {
  id      String @id @default(cuid())
  orderId String @unique
  order   Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)

  stockQty      Int @default(0)
  inProcessQty  Int @default(0)
  holdQty       Int @default(0)
  dispatchQty   Int @default(0)

  startedAt   DateTime?
  completedAt DateTime?
  notes       String?

  transactions InventoryTransaction[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// Current stock per SKU. Row-locked during transitions to prevent
// the double-counting the report warns about.
model InventoryItem {
  id           String     @id @default(cuid())
  partColourId String     @unique
  partColour   PartColour @relation(fields: [partColourId], references: [id], onDelete: Cascade)

  availableQty Int @default(0)
  reservedQty  Int @default(0)
  inProcessQty Int @default(0)
  holdQty      Int @default(0)
  confirmedQty Int @default(0)

  version Int @default(0) // optimistic concurrency

  transactions InventoryTransaction[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

enum InventoryState {
  RESERVED
  IN_PRODUCTION
  ON_HOLD
  CONFIRMED
  DISPATCHED
  RELEASED
}

// Append-only ledger. Never mutate; always insert.
model InventoryTransaction {
  id              String         @id @default(cuid())
  inventoryItemId String
  inventoryItem   InventoryItem  @relation(fields: [inventoryItemId], references: [id])
  productionId    String?
  production      ProductionRecord? @relation(fields: [productionId], references: [id])

  fromState InventoryState?
  toState   InventoryState
  qty       Int
  reason    String?
  actorId   String?

  createdAt DateTime @default(now())

  @@index([inventoryItemId])
  @@index([productionId])
  @@index([createdAt])
}

// ─────────────────────────────────────────────────────────────
// ACCOUNTS & DISPATCH
// ─────────────────────────────────────────────────────────────

enum InvoiceType {
  DUMMY
  FINAL
}

// Uploaded invoice documents (Module 5). Distinct from the runtime-generated PI.
model Invoice {
  id      String      @id @default(cuid())
  orderId String
  order   Order       @relation(fields: [orderId], references: [id], onDelete: Cascade)
  type    InvoiceType
  invoiceNo String?   @unique

  amount          Decimal @db.Decimal(14, 2)
  cashDiscountPct Decimal? @db.Decimal(5, 2)
  cashDiscountAmt Decimal @db.Decimal(14, 2) @default(0)

  fileAssetId String?
  fileAsset   FileAsset? @relation(fields: [fileAssetId], references: [id])

  issuedAt   DateTime?
  uploadedById String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([orderId])
}

model Dispatch {
  id      String @id @default(cuid())
  orderId String @unique
  order   Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)

  boxName       String?
  dispatchDate  DateTime?
  transporterId String?
  transporter   Transporter? @relation(fields: [transporterId], references: [id])
  docketNumber  String?
  remarks       String?

  dispatchedAt DateTime?
  deliveredAt  DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([transporterId])
}

// ─────────────────────────────────────────────────────────────
// DOCUMENTS, FILES, AUDIT
// ─────────────────────────────────────────────────────────────

// PI/invoice numbering per financial year. Numbers persist; documents do not.
model DocumentSequence {
  id            String @id @default(cuid())
  docType       String // PI | INVOICE | ORDER
  financialYear String // e.g. "2026-27"
  prefix        String
  lastNumber    Int    @default(0)

  updatedAt DateTime @updatedAt

  @@unique([docType, financialYear])
}

// Who generated which document, when. The file itself is never stored.
model DocumentIssueLog {
  id         String   @id @default(cuid())
  orderId    String?
  order      Order?   @relation(fields: [orderId], references: [id])
  docType    String
  docNumber  String?
  issuedById String
  issuedBy   User     @relation(fields: [issuedById], references: [id])
  issuedAt   DateTime @default(now())

  @@index([orderId])
  @@index([issuedAt])
}

// Uploaded files only — artwork, receipts, invoices. Stored on VPS disk,
// outside the web root. DB holds the pointer, never the binary.
model FileAsset {
  id           String @id @default(cuid())
  path         String // relative to upload root
  originalName String
  mimeType     String
  sizeBytes    Int
  checksum     String?

  uploadedById String
  uploadedBy   User   @relation(fields: [uploadedById], references: [id])

  printingFrames PrintingFrame[]
  receipts       PaymentReceipt[]
  invoices       Invoice[]
  ekycDocuments  EkycDocument[]

  createdAt DateTime @default(now())

  @@index([uploadedById])
}

model AuditLog {
  id         String   @id @default(cuid())
  entityType String
  entityId   String
  action     String
  fromValue  Json?
  toValue    Json?

  actorId String?
  actor   User?   @relation(fields: [actorId], references: [id])

  ipAddress String?
  createdAt DateTime @default(now())

  @@index([entityType, entityId])
  @@index([actorId])
  @@index([createdAt])
}

enum NotificationChannel {
  IN_APP
  EMAIL
  WHATSAPP
}

model Notification {
  id        String              @id @default(cuid())
  userId    String
  user      User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  channel   NotificationChannel @default(IN_APP)
  event     String
  title     String
  body      String
  link      String?
  isRead    Boolean             @default(false)
  sentAt    DateTime?

  createdAt DateTime @default(now())

  @@index([userId, isRead])
  @@index([createdAt])
}

enum ExternalNotifyStatus {
  LOGGED // recorded in-app only — real sending not wired up yet
  SENT
  FAILED
}

/**
 * Dealer-facing notifications. Dealers have no login (TECH_STACK.md §2), so
 * this is separate from Notification, which is scoped to internal Users.
 *
 * Right now every row is created as LOGGED — this is the frame for the
 * WhatsApp/email integration, not the integration itself. Wiring a real
 * provider later means writing to `status`/`sentAt` from a job; nothing about
 * this shape changes.
 */
model DealerNotification {
  id       String              @id @default(cuid())
  orderId  String
  order    Order               @relation(fields: [orderId], references: [id], onDelete: Cascade)
  dealerId String
  dealer   Dealer              @relation(fields: [dealerId], references: [id])

  channel ExternalNotifyChannel
  event   String
  message String

  status ExternalNotifyStatus @default(LOGGED)
  sentAt DateTime?

  createdAt DateTime @default(now())

  @@index([orderId])
  @@index([dealerId, createdAt])
}

enum ExternalNotifyChannel {
  EMAIL
  WHATSAPP
}

/**
 * Login OTP challenge — a second factor after the password check succeeds.
 *
 * Delivery is a stub today: the code is logged server-side (see
 * src/lib/otp.ts) instead of actually sent by email/WhatsApp, since no
 * provider is chosen yet. Swapping in a real provider only changes where
 * the code is sent, not this model or the verify flow.
 */
model LoginOtp {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  codeHash  String
  channel   ExternalNotifyChannel
  expiresAt DateTime
  consumedAt DateTime?
  attempts  Int      @default(0)

  createdAt DateTime @default(now())

  @@index([userId, expiresAt])
}
