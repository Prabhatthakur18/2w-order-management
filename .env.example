# Copy to .env.local and fill in. Never commit .env.local.

# PostgreSQL running natively on Windows as a service — nothing to start.
DATABASE_URL="postgresql://twom:twom@localhost:5432/twom_dev?schema=public"

# Auth.js — generate with: npx auth secret
AUTH_SECRET="replace-me"
AUTH_TRUST_HOST=true

# VPS upload root. Must live OUTSIDE the web root.
UPLOAD_ROOT="./.uploads"
MAX_UPLOAD_MB=8

# Email (Phase 3)
# RESEND_API_KEY=
# MAIL_FROM="orders@example.com"

# GSTIN lookup — gstincheck.co.in (https://documenter.getpostman.com/view/66843/2sBXirj8Lf)
GSTINCHECK_API_KEY="replace-me"
