# Copy to .env.local and fill in. Never commit .env.local.

# PostgreSQL 16 running natively inside WSL2 Ubuntu, on port 5433.
# 5432 is taken by a Windows PostgreSQL 17 service used by another project.
DATABASE_URL="postgresql://twom:twom@localhost:5433/twom_dev?schema=public"

# Auth.js — generate with: npx auth secret
AUTH_SECRET="replace-me"
AUTH_TRUST_HOST=true

# VPS upload root. Must live OUTSIDE the web root.
UPLOAD_ROOT="./.uploads"
MAX_UPLOAD_MB=8

# Email (Phase 3)
# RESEND_API_KEY=
# MAIL_FROM="orders@example.com"
